{
  "name": "larify",
  "version": "0.0.7",
  "description": "From reference design to customer delivery",
  "author": "递归探索",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:browser-live": "node tests/extensions/browser/live/run-all-tools.mjs && node tests/extensions/browser/live/run-oopif-screenshot.mjs && node tests/extensions/browser/live/run-drag.mjs && node tests/extensions/browser/live/run-input.mjs",
    "test:layout-performance": "node tests/performance/layout-resize.cdp.mjs",
    "test:window-maximize-performance": "node tests/performance/window-maximize.cdp.mjs",
    "test:window-maximize-ab": "node tests/performance/window-maximize-ab.cdp.mjs",
    "test:window-maximize-trace": "node tests/performance/window-maximize-trace.cdp.mjs",
    "test:layout-interaction-performance": "node tests/performance/layout-interaction-performance.cdp.mjs",
    "test:layout-environment-matrix": "node tests/performance/layout-environment-matrix.cdp.mjs",
    "test:layout-startup-divider-performance": "node tests/performance/layout-startup-divider-performance.cdp.mjs",
    "test:layout-stress-performance": "node tests/performance/layout-stress-performance.cdp.mjs",
    "test:message-list-navigation": "node tests/performance/message-list-navigation.cdp.mjs",
    "test:workbench-performance-suite": "node tests/performance/workbench-performance-suite.mjs",
    "test:workbench-responsive": "node tests/renderer/app/workbench/workbench-empty.cdp.mjs",
    "test:workbench-lifecycle": "node tests/renderer/app/workbench/workbench-lifecycle.cdp.mjs",
    "test:workspace-ui": "node tests/extensions/workspace/renderer/workspace-layout.cdp.mjs",
    "test:workspace-changes": "node tests/extensions/workspace/renderer/changes-view.cdp.mjs",
    "test:workspace-git-refresh": "node tests/extensions/workspace/renderer/git-status-invalidation.cdp.mjs",
    "test:review-card": "node tests/renderer/app/interaction/assistant/changes-summary-card.cdp.mjs",
    "test:assistant-model": "node tests/renderer/app/interaction/assistant/model-selector.cdp.mjs",
    "test:assistant-message-link": "node tests/renderer/app/interaction/assistant/message-link.cdp.mjs",
    "test:assistant-duration-persistence": "node tests/renderer/app/interaction/assistant/message-duration-persistence.cdp.mjs",
    "test:assistant-abort-duration": "node tests/renderer/app/interaction/assistant/message-abort-duration.cdp.mjs",
    "test:assistant-duration": "npm run test:assistant-duration-persistence && npm run test:assistant-abort-duration",
    "test:assistant-activity-history": "node tests/renderer/app/interaction/assistant/activity-history.cdp.mjs",
    "test:navigation-ui": "node tests/renderer/app/navigation-actions.cdp.mjs",
    "test:navigation-management": "node tests/renderer/app/navigation-management.cdp.mjs",
    "test:layout-corners": "node tests/renderer/app/layout-corners.cdp.mjs",
    "test:workspace-markdown": "node tests/extensions/workspace/renderer/workspace-markdown-preview.cdp.mjs",
    "test:workspace-markdown-external-url": "node tests/extensions/workspace/renderer/workspace-markdown-external-url.cdp.mjs",
    "test:workspace-browser-files": "node tests/extensions/workspace/renderer/workspace-browser-files.cdp.mjs",
    "test:terminal-ui": "node tests/extensions/terminal/terminal-workbench.cdp.mjs",
    "test:terminal-user": "node tests/extensions/terminal/terminal-user-flow.cdp.mjs",
    "test:terminal-agent": "node tests/extensions/terminal/terminal-agent-flow.cdp.mjs",
    "test:terminal-e2e": "npm run test:terminal-ui && npm run test:terminal-user && npm run test:terminal-agent",
    "test:browser-ui": "node tests/extensions/browser/browser-workbench.cdp.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:preview": "electron-vite build && electron-vite preview",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222 --user-data-dir=%USERPROFILE%\\.larify-debug",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.30",
