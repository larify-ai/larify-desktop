{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/extensions/*/renderer/**/*",
    "src/extensions/*/shared/**/*",
    "src/shared/**/*",
    "src/main/core/model/config.ts",
    "src/preload/*.d.ts"
  ],
  "exclude": ["src/extensions/shell/renderer/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
