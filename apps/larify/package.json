{
  "name": "larify",
  "version": "0.0.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "nest:run": "electron-vite build --logLevel error && electron . --nest-run",
    "test:browser-live": "node tests/extensions/browser/live/run-oopif-screenshot.mjs && node tests/extensions/browser/live/run-drag.mjs && node tests/extensions/browser/live/run-input.mjs",
    "test:layout-performance": "node tests/performance/layout-resize.cdp.mjs",
    "test:workbench-responsive": "node tests/renderer/app/workbench/workbench-empty.cdp.mjs",
    "test:terminal-ui": "node tests/extensions/terminal/terminal-workbench.cdp.mjs",
    "test:terminal-user": "node tests/extensions/terminal/terminal-user-flow.cdp.mjs",
    "test:terminal-agent": "node tests/extensions/terminal/terminal-agent-flow.cdp.mjs",
    "test:terminal-e2e": "npm run test:terminal-ui && npm run test:terminal-user && npm run test:terminal-agent",
    "test:browser-ui": "node tests/extensions/browser/browser-workbench.cdp.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:preview": "electron-vite build && electron-vite preview",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
