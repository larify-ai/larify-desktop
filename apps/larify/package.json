    "chardet": "^2.2.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "defuddle": "0.19.2",
    "diff": "^9.0.0",
    "dugite": "^3.2.2",
    "electron-updater": "^6.8.9",
    "file-type": "^22.0.2",
    "front-matter": "^4.0.2",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "jieba-wasm": "2.3.0",
    "liquidjs": "^10.27.2",
    "lucide-react": "^1.24.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mime-types": "^2.1.35",
    "monaco-editor": "^0.56.0",
    "motion": "^12.42.2",
